
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <title>TO-DO LIST</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            margin: 0;
        }

        .container {
            width: 600px;
            margin: 60px auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
        }

        .input-area {
            display: flex;
            gap: 10px;
        }

        #txtCongViec {
            flex: 1;
            height: 35px;
            padding: 5px 10px;
            box-sizing: border-box;
        }

        #btnThem {
            width: 90px;
            cursor: pointer;
        }

        ul {
            padding: 0;
            margin-top: 25px;
        }

        li {
            list-style: none;
            padding: 12px;
            margin-bottom: 8px;
            background-color: #eeeeee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            li.hoanThanh {
                text-decoration: line-through;
                color: gray;
            }

        .cong-viec {
            cursor: pointer;
            flex: 1;
        }

        .btnXoa {
            margin-left: 10px;
            cursor: pointer;
        }
    </style>

</head>


<body>

    <div class="container">

        <h2>TO-DO LIST</h2>


        <div class="input-area">

            <input type="text"
                   id="txtCongViec"
                   placeholder="Nhập công việc..." />

            <button type="button"
                    id="btnThem">

                Thêm

            </button>

        </div>


        <ul id="danhSachCongViec"></ul>

    </div>


    <script src="~/Scripts/Bai4.js/JavaScript.js"></script>

</body>

</html>
