@{
    ViewData["Title"] = "Bài 2";
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <title>Bài 2 - Thông tin giao hàng</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        .container {
            width: 600px;
            margin: auto;
        }

        h2 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 8px;
        }

        .label {
            width: 180px;
        }

        input[type="text"] {
            width: 280px;
            height: 28px;
            padding: 3px 6px;
            box-sizing: border-box;
        }

        .error {
            display: block;
            color: red;
            margin-top: 5px;
        }

        button {
            padding: 7px 18px;
            margin-right: 5px;
            cursor: pointer;
        }

        .center {
            text-align: center;
        }
    </style>

</head>


<body>

    <div class="container">

        <h2>THÔNG TIN GIAO HÀNG</h2>


        <form id="formGiaoHang">

            <table>

                <!-- TÊN -->
                <tr>

                    <td class="label">
                        Tên:
                    </td>

                    <td>

                        <input type="text"
                               id="ten" />

                        <span id="ten_error"
                              class="error">
                        </span>

                    </td>

                </tr>


                <!-- ĐỊA CHỈ -->
                <tr>

                    <td class="label">
                        Địa chỉ:
                    </td>

                    <td>

                        <input type="text"
                               id="diachi" />

                        <span id="diachi_error"
                              class="error">
                        </span>

                    </td>

                </tr>


                <!-- TỈNH / THÀNH PHỐ -->
                <tr>

                    <td class="label">
                        Tỉnh/Thành phố:
                    </td>

                    <td>

                        <input type="text"
                               id="tinhthanhpho" />

                        <span id="tinhthanhpho_error"
                              class="error">
                        </span>

                    </td>

                </tr>


                <!-- QUẬN / HUYỆN -->
                <tr>

                    <td class="label">
                        Quận/Huyện:
                    </td>

                    <td>

                        <input type="text"
                               id="quanhuyen" />

                        <span id="quanhuyen_error"
                              class="error">
                        </span>

                    </td>

                </tr>


                <!-- PHƯỜNG / XÃ -->
                <tr>

                    <td class="label">
                        Phường/Xã:
                    </td>

                    <td>

                        <input type="text"
                               id="phuongxa" />

                        <span id="phuongxa_error"
                              class="error">
                        </span>

                    </td>

                </tr>


                <!-- SỐ ĐIỆN THOẠI -->
                <tr>

                    <td class="label">
                        Số điện thoại:
                    </td>

                    <td>

                        <input type="text"
                               id="sodienthoai" />

                        <span id="sodienthoai_error"
                              class="error">
                        </span>

                    </td>

                </tr>


                <!-- NƠI GIAO HÀNG -->
                <tr>

                    <td class="label">
                        Nơi giao hàng:
                    </td>

                    <td>

                        <button type="button"
                                id="btnVanPhong">

                            Văn phòng

                        </button>


                        <button type="button"
                                id="btnNhaRieng">

                            Nhà riêng

                        </button>

                    </td>

                </tr>


                <!-- NÚT LƯU -->
                <tr>

                    <td colspan="2"
                        class="center">

                        <button type="button"
                                id="btnLuu">

                            Lưu

                        </button>

                    </td>

                </tr>

            </table>

        </form>

    </div>


    <!-- JavaScript -->

    <script src ="~/Scripts/Bai2.js/JavaScript.js"></script>

</body>

</html>